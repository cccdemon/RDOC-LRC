DISCORD_TOKEN=
DISCORD_APP_ID=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

PORT=3007
TZ=Europe/Berlin

# Web UI (optional). If any of CLIENT_ID/CLIENT_SECRET/PUBLIC_URL is empty the UI stays disabled.
# Discord application: OAuth2 -> Redirects -> add "<WEB_PUBLIC_URL>/auth/callback".
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
WEB_PUBLIC_URL=
WEB_SESSION_SECRET=
RDOC_BOOTSTRAP_ADMIN_ID=
RDOC_OPERATOR_USER_IDS=

# Caddy TLS via Cloudflare DNS challenge.
RDOC_LRC_DOMAIN=relay.raumdock.org
RDOC_LRC_HTTP_PORT=3016
RDOC_LRC_HTTPS_PORT=3017
CLOUDFLARE_API_TOKEN=
