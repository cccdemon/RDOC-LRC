<%- include('_header', { title: 'Audit log', session: session }) %>

<h1>Audit log <% if (page === 0) { %><span class="live-dot" title="auto-refresh every 5s"></span><% } %></h1>

<div class="card">
  <% if (total === 0) { %>
    <p class="muted">No audit entries yet.</p>
  <% } else { %>
    <p class="muted small">
      Showing <%= page * limit + 1 %>&ndash;<%= Math.min((page + 1) * limit, total) %> of <%= total %>. Newest first.
      <% if (page === 0) { %>Live &mdash; refreshes every 5s.<% } %>
      Audit log is append-only and capped at 5000 entries.
    </p>
    <table class="data">
      <thead>
        <tr>
          <th>When (UTC)</th>
          <th>User</th>
          <th>Action</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody id="audit-rows"
        <% if (page === 0) { %>hx-get="/audit/fragment" hx-trigger="every 5s" hx-swap="innerHTML"<% } %>
      >
        <%- include('audit-rows', { entries: entries }) %>
      </tbody>
    </table>
    <div class="pagination">
      <% if (page > 0) { %><a href="?page=<%= page - 1 %>" class="btn small">&larr; Newer</a><% } %>
      <% if ((page + 1) * limit < total) { %><a href="?page=<%= page + 1 %>" class="btn small">Older &rarr;</a><% } %>
    </div>
  <% } %>
</div>

<%- include('_footer') %>
