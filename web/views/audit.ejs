<%- include('_header', { title: 'Audit log', session: session }) %>

<h1>Audit log</h1>

<div class="card">
  <% if (total === 0) { %>
    <p class="muted">No audit entries yet.</p>
  <% } else { %>
    <p class="muted small">
      Showing <%= page * limit + 1 %>&ndash;<%= Math.min((page + 1) * limit, total) %> of <%= total %>. Newest first.
      Audit log is append-only and capped at 5000 entries (oldest are dropped automatically).
    </p>
    <table class="data">
      <thead>
        <tr>
          <th>When (UTC)</th>
          <th>User</th>
          <th>Action</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody>
        <% entries.forEach(function(e) { %>
          <tr>
            <td class="small mono"><%= new Date(e.ts).toISOString().slice(0, 19).replace('T', ' ') %></td>
            <td>
              <%= e.username || '(unknown)' %>
              <% if (e.userId) { %><br><span class="muted small mono"><%= e.userId %></span><% } %>
            </td>
            <td><span class="action-tag"><%= e.action %></span></td>
            <td class="small detail-cell"><%= JSON.stringify(e.details) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="pagination">
      <% if (page > 0) { %><a href="?page=<%= page - 1 %>" class="btn small">&larr; Newer</a><% } %>
      <% if ((page + 1) * limit < total) { %><a href="?page=<%= page + 1 %>" class="btn small">Older &rarr;</a><% } %>
    </div>
  <% } %>
</div>

<%- include('_footer') %>
