<%- include('_header', { title: 'Room: ' + room, session: session }) %>

<% if (flash && flash.error) { %>
  <div class="flash flash-error"><%= flash.error %></div>
<% } %>
<% if (flash && flash.ok) { %>
  <div class="flash flash-ok">
    <p><%= flash.ok %></p>
    <% if (flash.pruneDetails && flash.pruneDetails.length > 0) { %>
      <ul class="small detail-list">
        <% flash.pruneDetails.forEach(function(d) { %>
          <li>guild=<code><%= d.guildId %></code> channel=<code><%= d.channelId %></code> &mdash; <%= d.reason %></li>
        <% }) %>
      </ul>
    <% } %>
  </div>
<% } %>

<p><a href="/rooms" class="muted">&larr; All rooms</a></p>
<h1>Room: <code><%= room %></code></h1>

<div class="card">
  <h2>Members (<%= members.length %>)</h2>
  <table class="data">
    <thead>
      <tr>
        <th>Server</th>
        <th>Channel</th>
        <th>Guild ID</th>
        <th>Channel ID</th>
      </tr>
    </thead>
    <tbody>
      <% members.forEach(function(m) { %>
        <tr>
          <td><%= m.guildName || '(unknown)' %></td>
          <td><%= m.channelName ? '#' + m.channelName : '(unknown)' %></td>
          <td><code><%= m.guildId %></code></td>
          <td><code><%= m.channelId %></code></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2>Rules</h2>
  <% if (rules) { %>
    <p class="muted small">Posted to every channel in this room on <code>/bridge join</code>, and on <code>/bridge rules</code>.</p>
    <pre class="rules-preview"><%= rules %></pre>
  <% } else { %>
    <p class="muted">No rules set for this room.</p>
  <% } %>

  <% if (session.role === 'admin') { %>
    <form method="post" action="/rooms/<%= encodeURIComponent(room) %>/rules">
      <input type="hidden" name="_csrf" value="<%= session.csrf %>">
      <label for="rules-textarea">Rules (Markdown, max <%= rulesMax %> chars)</label>
      <textarea id="rules-textarea" name="rules" rows="10" maxlength="<%= rulesMax %>" placeholder="**House rules**&#10;- Be respectful.&#10;- No spam.&#10;- ..."><%= rules %></textarea>
      <p class="muted small">Empty input clears the rules. Discord Markdown is supported.</p>
      <button type="submit" class="btn primary">Save rules</button>
      <% if (rules) { %>
        <button type="submit" form="rules-clear-form" class="btn danger">Clear rules</button>
      <% } %>
    </form>
    <% if (rules) { %>
      <form id="rules-clear-form" method="post" action="/rooms/<%= encodeURIComponent(room) %>/rules/clear" onsubmit="return confirm('Clear the rules for room \'<%= room %>\'?');" class="inline">
        <input type="hidden" name="_csrf" value="<%= session.csrf %>">
      </form>
    <% } %>
  <% } %>
</div>

<% if (session.role === 'admin') { %>
  <div class="card">
    <h2>Mentions</h2>
    <p class="muted">Controls how Discord user mentions are relayed across servers. Mass mentions and role mentions stay disabled.</p>
    <form method="post" action="/rooms/<%= encodeURIComponent(room) %>/mention-mode">
      <input type="hidden" name="_csrf" value="<%= session.csrf %>">
      <label>Mode
        <select name="mode">
          <option value="off" <%= mentionMode === 'off' ? 'selected' : '' %>>Off (plain names)</option>
          <option value="names-only" <%= mentionMode === 'names-only' ? 'selected' : '' %>>Names only</option>
          <option value="resolve-users" <%= mentionMode === 'resolve-users' ? 'selected' : '' %>>Resolve users when possible</option>
        </select>
      </label>
      <button type="submit" class="btn primary">Update mentions</button>
    </form>
  </div>

  <div class="grid-2">
    <div class="card">
      <h2>Banned users</h2>
      <% if (bannedUsers.length === 0) { %>
        <p class="muted">No users banned in this room.</p>
      <% } else { %>
        <table class="data">
          <thead><tr><th>User ID</th><th class="actions-col">Actions</th></tr></thead>
          <tbody>
            <% bannedUsers.forEach(function(userId) { %>
              <tr>
                <td><code><%= userId %></code></td>
                <td class="actions">
                  <form method="post" action="/rooms/<%= encodeURIComponent(room) %>/bans/remove" class="inline">
                    <input type="hidden" name="_csrf" value="<%= session.csrf %>">
                    <input type="hidden" name="userId" value="<%= userId %>">
                    <button type="submit" class="btn small danger">Unban</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
      <form method="post" action="/rooms/<%= encodeURIComponent(room) %>/bans/add">
        <input type="hidden" name="_csrf" value="<%= session.csrf %>">
        <label>Discord user ID
          <input type="text" name="userId" placeholder="123456789012345678">
        </label>
        <button type="submit" class="btn primary">Ban user</button>
      </form>
    </div>

    <div class="card">
      <h2>Bad-word filter</h2>
      <form method="post" action="/rooms/<%= encodeURIComponent(room) %>/badwords/mode">
        <input type="hidden" name="_csrf" value="<%= session.csrf %>">
        <label>Mode
          <select name="mode">
            <option value="off" <%= badwordConfig.mode === 'off' ? 'selected' : '' %>>Off</option>
            <option value="block" <%= badwordConfig.mode === 'block' ? 'selected' : '' %>>Block messages</option>
            <option value="mask" <%= badwordConfig.mode === 'mask' ? 'selected' : '' %>>Mask matches</option>
          </select>
        </label>
        <button type="submit" class="btn primary">Update filter</button>
      </form>
      <% if (badwordConfig.words.length === 0) { %>
        <p class="muted">No words or phrases configured.</p>
      <% } else { %>
        <table class="data">
          <thead><tr><th>Word / phrase</th><th class="actions-col">Actions</th></tr></thead>
          <tbody>
            <% badwordConfig.words.forEach(function(word) { %>
              <tr>
                <td><code><%= word %></code></td>
                <td class="actions">
                  <form method="post" action="/rooms/<%= encodeURIComponent(room) %>/badwords/remove" class="inline">
                    <input type="hidden" name="_csrf" value="<%= session.csrf %>">
                    <input type="hidden" name="word" value="<%= word %>">
                    <button type="submit" class="btn small danger">Remove</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
      <form method="post" action="/rooms/<%= encodeURIComponent(room) %>/badwords/add">
        <input type="hidden" name="_csrf" value="<%= session.csrf %>">
        <label>Word or phrase
          <input type="text" name="word" placeholder="blocked phrase">
        </label>
        <button type="submit" class="btn primary">Add entry</button>
        <% if (badwordConfig.words.length > 0) { %>
          <button type="submit" form="badwords-clear-form" class="btn danger">Clear list</button>
        <% } %>
      </form>
      <% if (badwordConfig.words.length > 0) { %>
        <form id="badwords-clear-form" method="post" action="/rooms/<%= encodeURIComponent(room) %>/badwords/clear" class="inline" onsubmit="return confirm('Clear bad-word list for room <%= room %>?');">
          <input type="hidden" name="_csrf" value="<%= session.csrf %>">
        </form>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h2>Weblink filter</h2>
    <p class="muted">Per-room URL allowlist. Affects every server in the federation.</p>
    <p><a class="btn small" href="/rooms/<%= encodeURIComponent(room) %>/weblink">Manage weblink filter &rarr;</a></p>
  </div>

  <div class="card">
    <h2>Prune stale channels in this room</h2>
    <p class="muted">Contacts Discord for each member channel and removes any binding whose channel or guild no longer exists. Cache and Redis are updated atomically.</p>
    <form method="post" action="/rooms/<%= encodeURIComponent(room) %>/prune" onsubmit="return confirm('Prune stale channels in room \'<%= room %>\'?');">
      <input type="hidden" name="_csrf" value="<%= session.csrf %>">
      <button type="submit" class="btn danger">Prune stale channels</button>
    </form>
  </div>
<% } %>

<%- include('_footer') %>
