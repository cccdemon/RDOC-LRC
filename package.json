{
  "name": "rdoc-lc-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "Raumdock-Longrange-Communicator — multi-tenant Discord bridge with web admin GUI",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "npm --workspace @rdoc-lc/bot run start",
    "dev": "npm --workspace @rdoc-lc/bot run dev",
    "admin": "npm --workspace @rdoc-lc/bot run admin --"
  },
  "engines": {
    "node": ">=20"
  }
}
